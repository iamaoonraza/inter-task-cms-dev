{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundle-builder.js' | asset_url }}" type="module"></script>

{%- assign bundle_available = true -%}

<div class="page-width bundle-builder-section">
  {%- if section.settings.heading != blank -%}
    <h2 class="bundle-builder__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div class="bundle-builder__intro">{{ section.settings.intro }}</div>
  {%- endif -%}

  {%- if request.design_mode and section.blocks.size < 3 -%}
    <p class="bundle-builder__notice">Add 3 groups to build a 3-pack. The bundle currently uses {{ section.blocks.size }}.</p>
  {%- endif -%}

  <bundle-builder
    data-cart-add-url="{{ routes.cart_add_url }}.js"
    data-cart-url="{{ routes.cart_url }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-locale="{{ request.locale.iso_code }}"
    data-bundle-name="{{ section.settings.bundle_name | escape }}"
    data-missing-message="{{ section.settings.missing_message | escape }}"
    data-added-message="{{ section.settings.added_message | escape }}"
    data-error-message="{{ section.settings.error_message | escape }}"
    data-view-cart-label="{{ section.settings.view_cart_label | escape }}"
    data-not-selected="{{ section.settings.not_selected_label | escape }}"
  >
    <form class="bundle-builder__layout" novalidate autocomplete="off">
      <div class="bundle-builder__groups">
      {%- for block in section.blocks -%}
        {%- if block.settings.product_list != blank -%}
          {%- assign products = block.settings.product_list -%}
        {%- else -%}
          {%- assign products = block.settings.collection.products -%}
        {%- endif -%}

        {%- assign group_has_stock = false -%}

        <fieldset class="bundle-group" tabindex="-1" data-group="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          <legend class="bundle-group__title">{{ block.settings.title | escape }}</legend>

          <div class="bundle-group__items">
            {%- for product in products limit: 12 -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              {%- if product.available -%}
                {%- assign group_has_stock = true -%}
              {%- endif -%}

              <div class="bundle-item{% unless product.available %} bundle-item--sold-out{% endunless %}">
                <label class="bundle-item__main">
                  <input
                    type="radio"
                    class="bundle-item__input"
                    name="bundle-{{ section.id }}-{{ block.id }}"
                    value="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    data-title="{{ product.title | escape }}{% unless product.has_only_default_variant %} - {{ variant.title | escape }}{% endunless %}"
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 300
                      | image_tag: loading: 'lazy', widths: '150, 300', sizes: '150px', alt: product.title, class: 'bundle-item__image'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'bundle-item__image' }}
                  {%- endif -%}
                  <span class="bundle-item__title">{{ product.title | escape }}</span>
                  <span class="bundle-item__price" data-item-price>{{ variant.price | money }}</span>
                  {%- unless product.available -%}
                    <span class="bundle-item__badge">{{ section.settings.sold_out_label | escape }}</span>
                  {%- endunless -%}
                </label>

                {%- if product.available and product.has_only_default_variant == false -%}
                  <label class="bundle-item__variant">
                    <span class="bundle-item__variant-label">{{ product.title | escape }}</span>
                    <select data-variant-select>
                      {%- for option in product.variants -%}
                        <option
                          value="{{ option.id }}"
                          data-price="{{ option.price }}"
                          data-price-label="{{ option.price | money | escape }}"
                          data-title="{{ product.title | escape }} - {{ option.title | escape }}"
                          {% if option.id == variant.id %}
                            selected
                          {% endif %}
                          {% unless option.available %}
                            disabled
                          {% endunless %}
                        >
                          {{- option.title | escape -}}
                          {%- unless option.available %} ({{ section.settings.sold_out_label | escape }}){% endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                  </label>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- unless group_has_stock -%}
            {%- assign bundle_available = false -%}
            <p class="bundle-group__empty">{{ section.settings.unavailable_message | escape }}</p>
          {%- endunless -%}
        </fieldset>
      {%- endfor -%}
      </div>

      <div class="bundle-summary">
        <h3 class="bundle-summary__heading">{{ section.settings.summary_heading | escape }}</h3>
        <ul class="bundle-summary__items">
          {%- for block in section.blocks -%}
            <li data-summary-item>{{ section.settings.not_selected_label | escape }}</li>
          {%- endfor -%}
        </ul>
        <p class="bundle-summary__total">
          <span>{{ section.settings.total_label | escape }}</span>
          <output data-total>{{ 0 | money }}</output>
        </p>
        <button
          type="submit"
          class="button bundle-summary__button"
          data-submit
          {% unless bundle_available %}
            disabled
          {% endunless %}
        >
          {{ section.settings.button_label | escape }}
        </button>
        <p class="bundle-summary__status" role="status" data-status></p>
      </div>
    </form>
  </bundle-builder>
</div>

{% schema %}
{
  "name": "Bundle builder",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your 3-pack"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Pick one item from each group.</p>"
    },
    {
      "type": "text",
      "id": "bundle_name",
      "label": "Bundle name",
      "info": "Shown on each cart line so customers can see the items belong together.",
      "default": "3-pack bundle"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Summary heading",
      "default": "Your bundle"
    },
    {
      "type": "text",
      "id": "not_selected_label",
      "label": "Empty summary line",
      "default": "Not selected yet"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Bundle total"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add bundle to cart"
    },
    {
      "type": "text",
      "id": "view_cart_label",
      "label": "View cart link",
      "default": "View cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "missing_message",
      "label": "Item missing from a group",
      "default": "Please choose an item from:"
    },
    {
      "type": "text",
      "id": "added_message",
      "label": "Bundle added",
      "default": "Your bundle was added to the cart."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Cart request failed",
      "default": "We couldn't add your bundle. Please check your connection and try again."
    },
    {
      "type": "text",
      "id": "unavailable_message",
      "label": "Whole group sold out",
      "default": "Everything in this group is sold out, so the bundle is unavailable right now."
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Product group",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Group title",
          "default": "Choose an item"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Product list",
          "info": "Used instead of the collection when products are selected here.",
          "limit": 12
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle builder",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "title": "Choose your first item"
          }
        },
        {
          "type": "group",
          "settings": {
            "title": "Choose your second item"
          }
        },
        {
          "type": "group",
          "settings": {
            "title": "Choose your third item"
          }
        }
      ]
    }
  ]
}
{% endschema %}
